{
  "name": "driftlings",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "curate": "esbuild tools/curate.mts --bundle --platform=node --format=esm --outfile=.build/curate.mjs --log-level=warning && node .build/curate.mjs",
    "verify:pack": "esbuild tools/verify-pack.mts --bundle --platform=node --format=esm --outfile=.build/verify-pack.mjs --log-level=warning && node .build/verify-pack.mjs"
  },
  "dependencies": {
    "@driftbox/engine": "^0.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.4",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
